LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Amazon Reviews 2023 ingest defaults
SMARTSHOP_HF_DATASET_NAME=McAuley-Lab/Amazon-Reviews-2023
SMARTSHOP_AMAZON_CATEGORIES=all
SMARTSHOP_RAW_OUTPUT_DIR=data/raw/amazon_reviews_2023
SMARTSHOP_MAX_PRODUCTS=5000
SMARTSHOP_MAX_REVIEWS=20000

# Spark ETL defaults after running jobs.amazon_reviews_2023
SMARTSHOP_PRODUCTS_INPUT=data/raw/amazon_reviews_2023/combined/meta.jsonl
SMARTSHOP_REVIEWS_INPUT=data/raw/amazon_reviews_2023/combined/reviews.jsonl
SMARTSHOP_PRODUCTS_OUTPUT=data/processed/products_processed
SMARTSHOP_OUTPUT_FORMAT=parquet
SPARK_MASTER=local[*]

# Phase 3 model serving in the API (requires mlflow => full-runtime image
# or local Conda env). Leave unset to keep /predict/rating disabled.
# SMARTSHOP_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# SMARTSHOP_RATING_MODEL_URI=models:/SmartShopRatingClassifier@champion
# SMARTSHOP_RATING_MODEL_ENABLED=true
